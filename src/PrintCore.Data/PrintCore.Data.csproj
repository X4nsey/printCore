<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>PrintCore.Data</RootNamespace>
    <AssemblyName>PrintCore.Data</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PrintCore.Core\PrintCore.Core.csproj" />
    <ProjectReference Include="..\PrintCore.Logging\PrintCore.Logging.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Распространение собственной библиотеки SQLite для Windows 7/8/8.1/10/11 (x86 и x64) -->
    <Content Include="$(NuGetPackageRoot)sqlitepclraw.lib.e_sqlite3\2.1.11\runtimes\win-x86\native\e_sqlite3.dll"
             Condition="Exists('$(NuGetPackageRoot)sqlitepclraw.lib.e_sqlite3\2.1.11\runtimes\win-x86\native\e_sqlite3.dll')">
      <Link>runtimes\win-x86\native\e_sqlite3.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(NuGetPackageRoot)sqlitepclraw.lib.e_sqlite3\2.1.11\runtimes\win-x64\native\e_sqlite3.dll"
             Condition="Exists('$(NuGetPackageRoot)sqlitepclraw.lib.e_sqlite3\2.1.11\runtimes\win-x64\native\e_sqlite3.dll')">
      <Link>runtimes\win-x64\native\e_sqlite3.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>

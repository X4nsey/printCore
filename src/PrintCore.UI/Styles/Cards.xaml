<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:PrintCore.Controls">

    <!-- Карточки, плитки иконок и разделители -->

    <!-- Основная карточка -->
    <Style x:Key="Card" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource Brush.Background.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Card}" />
        <Setter Property="Padding" Value="{DynamicResource Padding.Card}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Карточка без внутренних отступов (для таблиц, списков на всю ширину) -->
    <Style x:Key="Card.Flush" TargetType="{x:Type Border}" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Вложенная подложка внутри карточки -->
    <Style x:Key="Surface.Subtle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource Brush.Background.Subtle}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,12" />
    </Style>

    <!-- Плитка с иконкой (акцентная) -->
    <Style x:Key="IconTile" TargetType="{x:Type Border}">
        <Setter Property="Width" Value="{DynamicResource Size.IconTile}" />
        <Setter Property="Height" Value="{DynamicResource Size.IconTile}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Subtle}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Accent.Text}" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <!-- Плитка с иконкой (нейтральная) -->
    <Style x:Key="IconTile.Neutral" TargetType="{x:Type Border}" BasedOn="{StaticResource IconTile}">
        <Setter Property="Background" Value="{DynamicResource Brush.Neutral.Subtle}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    </Style>

    <!-- Горизонтальный разделитель -->
    <Style x:Key="Divider" TargetType="{x:Type Border}">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Brush.Divider}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Вертикальный разделитель -->
    <Style x:Key="Divider.Vertical" TargetType="{x:Type Border}">
        <Setter Property="Width" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Brush.Divider}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Пустое состояние -->
    <Style TargetType="{x:Type controls:EmptyState}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Padding" Value="24,28" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:EmptyState}">
                    <StackPanel Margin="{TemplateBinding Padding}" HorizontalAlignment="Center">
                        <Border Width="44"
                                Height="44"
                                HorizontalAlignment="Center"
                                Background="{DynamicResource Brush.Neutral.Subtle}"
                                CornerRadius="22">
                            <controls:Icon Width="20"
                                           Height="20"
                                           Data="{TemplateBinding Icon}"
                                           Foreground="{DynamicResource Brush.Text.Secondary}" />
                        </Border>
                        <TextBlock Margin="0,14,0,0"
                                   HorizontalAlignment="Center"
                                   Style="{DynamicResource Text.BodyStrong}"
                                   FontSize="{DynamicResource FontSize.BodyLarge}"
                                   Text="{TemplateBinding Title}" />
                        <TextBlock MaxWidth="400"
                                   Margin="0,6,0,0"
                                   HorizontalAlignment="Center"
                                   Style="{DynamicResource Text.Paragraph}"
                                   Text="{TemplateBinding Description}"
                                   TextAlignment="Center" />
                        <ContentPresenter x:Name="Action" Margin="0,16,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="Action" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Бейдж состояния -->
    <Style TargetType="{x:Type controls:StatusBadge}">
        <Setter Property="Background" Value="{DynamicResource Brush.Neutral.Subtle}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:StatusBadge}">
                    <Border Padding="8,3,10,3"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource Radius.Pill}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6"
                                     Height="6"
                                     Margin="0,0,6,0"
                                     VerticalAlignment="Center"
                                     Fill="{TemplateBinding Foreground}" />
                            <TextBlock VerticalAlignment="Center" Text="{TemplateBinding Text}" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Tone" Value="Accent">
                <Setter Property="Background" Value="{DynamicResource Brush.Accent.Subtle}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Text}" />
            </Trigger>
            <Trigger Property="Tone" Value="Success">
                <Setter Property="Background" Value="{DynamicResource Brush.Success.Subtle}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
            </Trigger>
            <Trigger Property="Tone" Value="Warning">
                <Setter Property="Background" Value="{DynamicResource Brush.Warning.Subtle}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
            </Trigger>
            <Trigger Property="Tone" Value="Danger">
                <Setter Property="Background" Value="{DynamicResource Brush.Danger.Subtle}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>

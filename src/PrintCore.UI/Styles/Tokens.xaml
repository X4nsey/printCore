<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        Дизайн-токены PrintCore: типографика, размеры, отступы, скругления.
        Не зависят от темы. Все стили ссылаются только на эти значения.
    -->

    <!-- Типографика -->
    <FontFamily x:Key="Font.Text">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Display">Segoe UI Variable Display, Segoe UI</FontFamily>

    <sys:Double x:Key="FontSize.Caption">11.5</sys:Double>
    <sys:Double x:Key="FontSize.Body">13</sys:Double>
    <sys:Double x:Key="FontSize.BodyLarge">14</sys:Double>
    <sys:Double x:Key="FontSize.Subtitle">15</sys:Double>
    <sys:Double x:Key="FontSize.Title">18</sys:Double>
    <sys:Double x:Key="FontSize.PageTitle">20</sys:Double>
    <sys:Double x:Key="FontSize.Hero">26</sys:Double>
    <sys:Double x:Key="FontSize.Metric">28</sys:Double>

    <!-- Скругления -->
    <CornerRadius x:Key="Radius.Small">4</CornerRadius>
    <CornerRadius x:Key="Radius.Control">6</CornerRadius>
    <CornerRadius x:Key="Radius.Card">10</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">10</CornerRadius>

    <!-- Отступы -->
    <Thickness x:Key="Padding.Page">32,8,32,32</Thickness>
    <Thickness x:Key="Padding.Card">20</Thickness>
    <Thickness x:Key="Padding.Button">14,0,14,0</Thickness>
    <Thickness x:Key="Margin.SectionGap">0,0,0,20</Thickness>
    <Thickness x:Key="Margin.CardHeader">0,0,0,14</Thickness>
    <sys:Double x:Key="Spacing.Grid">16</sys:Double>

    <!-- Размеры -->
    <sys:Double x:Key="Size.Sidebar">248</sys:Double>
    <sys:Double x:Key="Size.TopBar">64</sys:Double>
    <sys:Double x:Key="Size.ControlHeight">34</sys:Double>
    <sys:Double x:Key="Size.NavItemHeight">38</sys:Double>
    <sys:Double x:Key="Size.Icon">18</sys:Double>
    <sys:Double x:Key="Size.IconSmall">16</sys:Double>
    <sys:Double x:Key="Size.IconTile">36</sys:Double>
    <sys:Double x:Key="Size.BorderThickness">1</sys:Double>

</ResourceDictionary>

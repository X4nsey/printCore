<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Тёмная тема PrintCore.
        Набор ключей должен полностью совпадать с Light.xaml.
    -->

    <!-- Фоны -->
    <SolidColorBrush x:Key="Brush.Background.App" Color="#16181C" />
    <SolidColorBrush x:Key="Brush.Background.Sidebar" Color="#1B1E23" />
    <SolidColorBrush x:Key="Brush.Background.TopBar" Color="#16181C" />
    <SolidColorBrush x:Key="Brush.Background.Card" Color="#1F2227" />
    <SolidColorBrush x:Key="Brush.Background.Subtle" Color="#23272D" />
    <SolidColorBrush x:Key="Brush.Background.Control" Color="#262A30" />
    <SolidColorBrush x:Key="Brush.Background.Hover" Color="#2A2E35" />
    <SolidColorBrush x:Key="Brush.Background.Pressed" Color="#31363E" />

    <!-- Границы -->
    <SolidColorBrush x:Key="Brush.Border.Default" Color="#2C3037" />
    <SolidColorBrush x:Key="Brush.Border.Strong" Color="#3A3F47" />
    <SolidColorBrush x:Key="Brush.Divider" Color="#2A2E34" />

    <!-- Текст -->
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#E7E9EC" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#A4AAB4" />
    <SolidColorBrush x:Key="Brush.Text.Tertiary" Color="#767D88" />
    <SolidColorBrush x:Key="Brush.Text.Disabled" Color="#555B64" />
    <SolidColorBrush x:Key="Brush.Text.OnAccent" Color="#FFFFFF" />

    <!-- Акцент -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#3B7BF0" />
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="#4D89F5" />
    <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="#2F6AD6" />
    <SolidColorBrush x:Key="Brush.Accent.Subtle" Color="#1D2A40" />
    <SolidColorBrush x:Key="Brush.Accent.Text" Color="#7EADFF" />

    <!-- Статусы -->
    <SolidColorBrush x:Key="Brush.Success" Color="#4ADE80" />
    <SolidColorBrush x:Key="Brush.Success.Subtle" Color="#18301F" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#FBBF24" />
    <SolidColorBrush x:Key="Brush.Warning.Subtle" Color="#33291A" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#F87171" />
    <SolidColorBrush x:Key="Brush.Danger.Subtle" Color="#3A1F21" />
    <SolidColorBrush x:Key="Brush.Neutral.Subtle" Color="#2A2E35" />

    <!-- Служебные -->
    <SolidColorBrush x:Key="Brush.Scrollbar.Thumb" Color="#3E434B" />
    <SolidColorBrush x:Key="Brush.Scrollbar.ThumbHover" Color="#575D67" />
    <SolidColorBrush x:Key="Brush.Focus" Color="#5B93F5" />
    <SolidColorBrush x:Key="Brush.WindowControl.CloseHover" Color="#C42B1C" />
    <Color x:Key="Color.Shadow">#40000000</Color>

</ResourceDictionary>

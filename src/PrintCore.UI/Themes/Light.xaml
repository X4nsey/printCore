<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Светлая тема PrintCore.
        Набор ключей должен полностью совпадать с Dark.xaml.
    -->

    <!-- Фоны -->
    <SolidColorBrush x:Key="Brush.Background.App" Color="#F4F5F7" />
    <SolidColorBrush x:Key="Brush.Background.Sidebar" Color="#FBFBFC" />
    <SolidColorBrush x:Key="Brush.Background.TopBar" Color="#F4F5F7" />
    <SolidColorBrush x:Key="Brush.Background.Card" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Background.Subtle" Color="#F7F8FA" />
    <SolidColorBrush x:Key="Brush.Background.Control" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Background.Hover" Color="#EEF0F3" />
    <SolidColorBrush x:Key="Brush.Background.Pressed" Color="#E5E8EC" />

    <!-- Границы -->
    <SolidColorBrush x:Key="Brush.Border.Default" Color="#E3E6EA" />
    <SolidColorBrush x:Key="Brush.Border.Strong" Color="#D2D6DC" />
    <SolidColorBrush x:Key="Brush.Divider" Color="#ECEEF1" />

    <!-- Текст -->
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#1F2329" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#5B6270" />
    <SolidColorBrush x:Key="Brush.Text.Tertiary" Color="#8A919D" />
    <SolidColorBrush x:Key="Brush.Text.Disabled" Color="#B4B9C1" />
    <SolidColorBrush x:Key="Brush.Text.OnAccent" Color="#FFFFFF" />

    <!-- Акцент -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#2563EB" />
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="#1D55D6" />
    <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="#1A49B8" />
    <SolidColorBrush x:Key="Brush.Accent.Subtle" Color="#EAF1FE" />
    <SolidColorBrush x:Key="Brush.Accent.Text" Color="#1D55D6" />

    <!-- Статусы -->
    <SolidColorBrush x:Key="Brush.Success" Color="#15803D" />
    <SolidColorBrush x:Key="Brush.Success.Subtle" Color="#E7F6EC" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#B45309" />
    <SolidColorBrush x:Key="Brush.Warning.Subtle" Color="#FDF3E3" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#C62828" />
    <SolidColorBrush x:Key="Brush.Danger.Subtle" Color="#FCEBEB" />
    <SolidColorBrush x:Key="Brush.Neutral.Subtle" Color="#EEF0F3" />

    <!-- Служебные -->
    <SolidColorBrush x:Key="Brush.Scrollbar.Thumb" Color="#C9CED5" />
    <SolidColorBrush x:Key="Brush.Scrollbar.ThumbHover" Color="#A9B0B9" />
    <SolidColorBrush x:Key="Brush.Focus" Color="#2563EB" />
    <SolidColorBrush x:Key="Brush.WindowControl.CloseHover" Color="#C42B1C" />
    <Color x:Key="Color.Shadow">#14212833</Color>

</ResourceDictionary>

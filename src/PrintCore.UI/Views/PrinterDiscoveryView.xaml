<UserControl x:Class="PrintCore.Views.PrinterDiscoveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PrintCore.Controls"
             xmlns:converters="clr-namespace:PrintCore.Converters">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:DriverStatusToTextConverter x:Key="StatusText" />
        <converters:DriverStatusToToneConverter x:Key="StatusTone" />
    </UserControl.Resources>

    <ScrollViewer Style="{DynamicResource PageScrollViewer}">
        <StackPanel MaxWidth="1360">

            <!-- 1. Верхняя карточка управления поиском и фильтрации -->
            <Border Margin="{DynamicResource Margin.SectionGap}"
                    Padding="20,16"
                    Style="{DynamicResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{DynamicResource Text.CardTitle}"
                                           Text="Обнаружение USB- и сетевых принтеров" />
                                <controls:StatusBadge Margin="12,0,0,0"
                                                      Text="Выполняется поиск…"
                                                      Tone="Accent"
                                                      Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                            <TextBlock Margin="0,4,0,0"
                                       Style="{DynamicResource Text.Caption}"
                                       Text="{Binding StatusMessage}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                            <Button Command="{Binding StartScanCommand}"
                                    Content="Обновить"
                                    Visibility="{Binding HasScanned, Converter={StaticResource BoolToVis}}"
                                    controls:Assist.Icon="{DynamicResource Icon.Refresh}" />
                            <Button Margin="8,0,0,0"
                                    Command="{Binding StopScanCommand}"
                                    Content="Остановить"
                                    Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"
                                    controls:Assist.Icon="{DynamicResource Icon.Alert}" />
                            <Button Margin="8,0,0,0"
                                    Command="{Binding StartScanCommand}"
                                    Content="Начать поиск"
                                    Style="{DynamicResource Button.Primary}"
                                    controls:Assist.Icon="{DynamicResource Icon.Scan}" />
                        </StackPanel>
                    </Grid>

                    <!-- Индикатор выполнения -->
                    <ProgressBar Grid.Row="1"
                                 Height="4"
                                 Margin="0,14,0,0"
                                 Background="{DynamicResource Brush.Neutral.Subtle}"
                                 BorderThickness="0"
                                 Foreground="{DynamicResource Brush.Accent}"
                                 IsIndeterminate="True"
                                 Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Border>

            <!-- 2. Основная сетка: таблица обнаруженных устройств + панель подробной информации и подбора драйвера -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.45*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <!-- Левая колонка: Таблица обнаруженных принтеров и фильтр по типу подключения -->
                <Border Grid.Column="0" Style="{DynamicResource Card.Flush}">
                    <Grid MinHeight="480">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Шапка таблицы с фильтром -->
                        <Grid Grid.Row="0" Margin="20,16,20,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{DynamicResource Text.CardTitle}"
                                           Text="Обнаруженные устройства" />
                                <TextBlock Margin="0,2,0,0"
                                           Style="{DynamicResource Text.Caption}"
                                           Text="Выберите принтер в списке для просмотра сведений и подбора драйвера" />
                            </StackPanel>

                            <!-- Фильтрация по типу подключения -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                                <Button Command="{Binding SetFilterCommand}"
                                        CommandParameter="All"
                                        Content="Все"
                                        Padding="10,0" />
                                <Button Margin="6,0,0,0"
                                        Command="{Binding SetFilterCommand}"
                                        CommandParameter="Usb"
                                        Content="USB"
                                        Padding="10,0"
                                        controls:Assist.Icon="{DynamicResource Icon.Usb}" />
                                <Button Margin="6,0,0,0"
                                        Command="{Binding SetFilterCommand}"
                                        CommandParameter="Network"
                                        Content="Сеть"
                                        Padding="10,0"
                                        controls:Assist.Icon="{DynamicResource Icon.Network}" />
                            </StackPanel>
                        </Grid>

                        <!-- Таблица и пустое состояние -->
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <DataGrid Grid.Row="0"
                                      ItemsSource="{Binding FilteredPrinters}"
                                      SelectedItem="{Binding SelectedPrinter, Mode=TwoWay}"
                                      Style="{DynamicResource DataTable}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Width="1.45*"
                                                        Binding="{Binding DisplayModel}"
                                                        ElementStyle="{DynamicResource DataTable.CellText}"
                                                        Header="Модель" />
                                    <DataGridTextColumn Width="0.9*"
                                                        Binding="{Binding DisplayManufacturer}"
                                                        ElementStyle="{DynamicResource DataTable.CellTextSecondary}"
                                                        Header="Производитель" />
                                    <DataGridTextColumn Width="1.05*"
                                                        Binding="{Binding ConnectionText}"
                                                        ElementStyle="{DynamicResource DataTable.CellTextSecondary}"
                                                        Header="Тип подключения" />
                                    <DataGridTextColumn Width="0.9*"
                                                        Binding="{Binding IpAddressText}"
                                                        ElementStyle="{DynamicResource DataTable.CellTextSecondary}"
                                                        Header="IP-адрес" />
                                    <DataGridTemplateColumn Width="1*" Header="Статус драйвера">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <controls:StatusBadge
                                                    Text="{Binding DriverStatus, Converter={StaticResource StatusText}}"
                                                    Tone="{Binding DriverStatus, Converter={StaticResource StatusTone}}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="0.95*" Header="Доступность">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <controls:StatusBadge
                                                    Text="{Binding AvailabilityText}"
                                                    Tone="{Binding AvailabilityTone}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <controls:EmptyState Grid.Row="1"
                                                 Description="Нажмите «Начать поиск», чтобы опросить USB-порты (WMI / Plug and Play) и локальную сеть (WSD, SNMP, TCP/IP)."
                                                 Icon="{DynamicResource Icon.Scan}"
                                                 Title="Список обнаруженных принтеров пуст"
                                                 Visibility="{Binding HasFilteredPrinters, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                                <Button Command="{Binding StartScanCommand}"
                                        Content="Начать поиск"
                                        Style="{DynamicResource Button.Primary}"
                                        controls:Assist.Icon="{DynamicResource Icon.Search}" />
                            </controls:EmptyState>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Правая колонка: Панель подробной информации о выбранном принтере и подбор драйвера -->
                <Border Grid.Column="2" Style="{DynamicResource Card}">
                    <Grid>
                        <!-- Пустое состояние, если принтер не выбран -->
                        <controls:EmptyState Description="Выберите обнаруженный принтер в таблице слева, чтобы просмотреть аппаратные идентификаторы, состояние подключения и подобрать подходящий драйвер."
                                             Icon="{DynamicResource Icon.Printer}"
                                             Title="Принтер не выбран"
                                             Visibility="{Binding HasSelectedPrinter, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />

                        <!-- Подробности выбранного принтера -->
                        <StackPanel Visibility="{Binding HasSelectedPrinter, Converter={StaticResource BoolToVis}}">
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Style="{DynamicResource IconTile}">
                                    <controls:Icon Data="{DynamicResource Icon.Printer}" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Style="{DynamicResource Text.CardTitle}"
                                               Text="{Binding SelectedPrinter.DisplayModel}" />
                                    <TextBlock Margin="0,2,0,0"
                                               Style="{DynamicResource Text.Caption}"
                                               Text="{Binding SelectedPrinter.StatusDetails}" />
                                </StackPanel>
                            </Grid>

                            <Border Style="{DynamicResource Divider}" />

                            <!-- Свойства устройства -->
                            <Grid Margin="0,12,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="135" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="26" />
                                    <RowDefinition Height="26" />
                                    <RowDefinition Height="26" />
                                    <RowDefinition Height="26" />
                                    <RowDefinition Height="26" />
                                    <RowDefinition Height="26" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{DynamicResource Text.Secondary}" Text="Производитель" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Style="{DynamicResource Text.BodyStrong}" Text="{Binding SelectedPrinter.DisplayManufacturer}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Style="{DynamicResource Text.Secondary}" Text="Подключение" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{DynamicResource Text.Body}" Text="{Binding SelectedPrinter.ConnectionText}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Style="{DynamicResource Text.Secondary}" Text="IP-адрес / Порт" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Style="{DynamicResource Text.Body}">
                                    <Run Text="{Binding SelectedPrinter.IpAddressText, Mode=OneWay}" />
                                    <Run Text=" (" /><Run Text="{Binding SelectedPrinter.PortName, Mode=OneWay}" /><Run Text=")" />
                                </TextBlock>

                                <TextBlock Grid.Row="3" Grid.Column="0" Style="{DynamicResource Text.Secondary}" Text="Hardware ID" />
                                <TextBlock Grid.Row="3" Grid.Column="1"
                                           Style="{DynamicResource Text.Body}"
                                           Text="{Binding SelectedPrinter.HardwareId, TargetNullValue='Не предоставлен устройством'}"
                                           ToolTip="{Binding SelectedPrinter.HardwareId}" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Style="{DynamicResource Text.Secondary}" Text="Device ID" />
                                <TextBlock Grid.Row="4" Grid.Column="1"
                                           Style="{DynamicResource Text.Body}"
                                           Text="{Binding SelectedPrinter.DeviceId}"
                                           ToolTip="{Binding SelectedPrinter.DeviceId}" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Style="{DynamicResource Text.Secondary}" Text="Текущий драйвер" />
                                <TextBlock Grid.Row="5" Grid.Column="1"
                                           Style="{DynamicResource Text.Body}"
                                           Text="{Binding SelectedPrinter.InstalledDriverName, TargetNullValue='Не установлен'}" />
                            </Grid>

                            <Button HorizontalAlignment="Stretch"
                                    Command="{Binding SearchDriverCommand}"
                                    Content="Подобрать подходящий драйвер"
                                    Style="{DynamicResource Button.Primary}"
                                    controls:Assist.Icon="{DynamicResource Icon.Search}" />

                            <!-- Результаты подбора драйвера -->
                            <StackPanel Margin="0,16,0,0"
                                        Visibility="{Binding DriverSearchStatus, Converter={StaticResource BoolToVis}}">
                                <Border Style="{DynamicResource Divider}" />
                                <TextBlock Margin="0,12,0,4"
                                           Style="{DynamicResource Text.BodyStrong}"
                                           Text="Подбор драйвера (локальная библиотека и онлайн-каталог)" />
                                <TextBlock Margin="0,0,0,10"
                                           Style="{DynamicResource Text.Caption}"
                                           Text="{Binding DriverSearchStatus}"
                                           TextWrapping="Wrap" />

                                <ListBox MaxHeight="200"
                                         ItemsSource="{Binding DriverCandidates}"
                                         SelectedItem="{Binding SelectedCandidate, Mode=TwoWay}"
                                         Style="{DynamicResource List}"
                                         Visibility="{Binding HasDriverCandidates, Converter={StaticResource BoolToVis}}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Style="{DynamicResource Text.BodyStrong}"
                                                               Text="{Binding Package.DisplayTitle}" />
                                                    <TextBlock Margin="0,2,0,0"
                                                               Style="{DynamicResource Text.Caption}"
                                                               Text="{Binding MatchText}" />
                                                    <TextBlock Margin="0,2,0,0"
                                                               Style="{DynamicResource Text.Caption}"
                                                               Text="{Binding CompatibilitySummary}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                                <controls:StatusBadge Grid.Column="1"
                                                                      Margin="8,0,0,0"
                                                                      VerticalAlignment="Top"
                                                                      Text="{Binding SourceBadgeText}"
                                                                      Tone="{Binding SourceBadgeTone}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- Панель предпросмотра перед установкой или переходом на сайт производителя -->
                                <Border Margin="0,10,0,0"
                                        Style="{DynamicResource Surface.Subtle}"
                                        Visibility="{Binding HasSelectedCandidate, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Style="{DynamicResource Text.BodyStrong}"
                                                   Text="{Binding SelectedCandidate.Package.DisplayTitle}" />
                                        <TextBlock Margin="0,3,0,0"
                                                   Style="{DynamicResource Text.Caption}">
                                            <Run Text="Версия: " /><Run Text="{Binding SelectedCandidate.Package.DriverVersion, Mode=OneWay}" />
                                            <Run Text=" · Архитектура: " /><Run Text="{Binding SelectedCandidate.Package.ArchitectureText, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Margin="0,2,0,0"
                                                   Style="{DynamicResource Text.Caption}">
                                            <Run Text="Источник: " /><Run Text="{Binding SelectedCandidate.Package.SourceName, Mode=OneWay}" />
                                        </TextBlock>

                                        <!-- Кнопка установки для локального пакета -->
                                        <Button Margin="0,10,0,0"
                                                HorizontalAlignment="Stretch"
                                                Command="{Binding InstallSelectedCandidateCommand}"
                                                Content="Установить выбранный драйвер"
                                                Style="{DynamicResource Button.Primary}"
                                                Visibility="{Binding SelectedCandidateIsLocal, Converter={StaticResource BoolToVis}}"
                                                controls:Assist.Icon="{DynamicResource Icon.Shield}" />

                                        <!-- Кнопка открытия официального сайта производителя -->
                                        <Button Margin="0,10,0,0"
                                                HorizontalAlignment="Stretch"
                                                Command="{Binding OpenOfficialSiteCommand}"
                                                Content="Открыть официальный сайт производителя"
                                                Visibility="{Binding SelectedCandidateRequiresBrowser, Converter={StaticResource BoolToVis}}"
                                                controls:Assist.Icon="{DynamicResource Icon.ArrowRight}" />
                                    </StackPanel>
                                </Border>

                                <!-- Результат установки -->
                                <Border Margin="0,10,0,0"
                                        Style="{DynamicResource Surface.Subtle}"
                                        Visibility="{Binding HasInstallResult, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <controls:StatusBadge Text="Результат операции"
                                                              Tone="{Binding InstallResultTone}" />
                                        <TextBlock Margin="0,6,0,0"
                                                   Style="{DynamicResource Text.Paragraph}"
                                                   Text="{Binding InstallResultMessage}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>

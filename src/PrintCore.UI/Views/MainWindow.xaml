<Window x:Class="PrintCore.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PrintCore.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="PrintCore"
        Icon="pack://application:,,,/Resources/Branding/printcore.ico"
        Width="1280"
        Height="800"
        MinWidth="980"
        MinHeight="640"
        Background="{DynamicResource Brush.Background.App}"
        FontFamily="{DynamicResource Font.Text}"
        FontSize="{DynamicResource FontSize.Body}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">

    <!-- Кастомная рамка окна: заголовок объединён с верхней панелью -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56"
                            CornerRadius="8"
                            GlassFrameThickness="1"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="WindowBorder"
            Background="{DynamicResource Brush.Background.App}"
            BorderBrush="{DynamicResource Brush.Border.Default}"
            BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <!-- 1. Левая боковая панель -->
                <ColumnDefinition Width="248" />
                <!-- 2+3. Верхняя панель и центральная рабочая область -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ==================== ЛЕВАЯ БОКОВАЯ ПАНЕЛЬ ==================== -->
            <Border Grid.Column="0" Style="{DynamicResource Sidebar}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Логотип и название PrintCore -->
                    <StackPanel Grid.Row="0"
                                Margin="20,18,16,18"
                                Orientation="Horizontal">
                        <Border Width="34"
                                Height="34"
                                Background="{DynamicResource Brush.Accent}"
                                CornerRadius="8">
                            <Control Width="30"
                                     Height="30"
                                     Focusable="False"
                                     Foreground="{DynamicResource Brush.Text.OnAccent}"
                                     IsTabStop="False"
                                     Template="{DynamicResource BrandLogoMarkTemplate}" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontFamily="{DynamicResource Font.Display}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Style="{DynamicResource Text.Base}"
                                       Text="PrintCore" />
                            <TextBlock Margin="0,1,0,0"
                                       Style="{DynamicResource Text.Caption}"
                                       Text="Управление печатью" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Основные разделы меню (п. 1–5) -->
                    <StackPanel Grid.Row="1"
                                Margin="12,4,12,0"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock Style="{DynamicResource Text.NavGroup}" Text="Разделы" />
                        <ItemsControl ItemTemplate="{DynamicResource NavItemTemplate}"
                                      ItemsSource="{Binding NavigationItems}" />
                    </StackPanel>

                    <!-- Нижний блок: Настройки (п. 6) и версия -->
                    <StackPanel Grid.Row="2"
                                Margin="12,0,12,14"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Border Margin="4,0,4,10" Style="{DynamicResource Divider}" />
                        <ItemsControl ItemTemplate="{DynamicResource NavItemTemplate}"
                                      ItemsSource="{Binding FooterNavigationItems}" />
                        <TextBlock Margin="12,10,0,0"
                                   Style="{DynamicResource Text.Caption}"
                                   Text="{Binding AppVersion, StringFormat='Версия {0}'}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== ПРАВАЯ ЧАСТЬ ОКНА ==================== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ==================== ВЕРХНЯЯ ПАНЕЛЬ ==================== -->
                <Grid Grid.Row="0"
                      MinHeight="{DynamicResource Size.TopBar}"
                      Background="{DynamicResource Brush.Background.TopBar}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Название текущего раздела -->
                    <StackPanel Grid.Column="0"
                                Margin="32,14,16,10"
                                VerticalAlignment="Center">
                        <TextBlock Style="{DynamicResource Text.PageTitle}"
                                   Text="{Binding CurrentPage.Title}" />
                        <TextBlock Margin="0,2,0,0"
                                   Style="{DynamicResource Text.Caption}"
                                   Text="{Binding CurrentPage.Subtitle}" />
                    </StackPanel>

                    <!-- Краткая информация о системе и быстрые кнопки управления -->
                    <StackPanel Grid.Column="1"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">

                        <!-- Плашка со сведениями о системе -->
                        <Border Padding="12,6"
                                Background="{DynamicResource Brush.Background.Card}"
                                BorderBrush="{DynamicResource Brush.Border.Default}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.Control}"
                                ToolTip="{Binding SystemInfo.Summary}">
                            <StackPanel Orientation="Horizontal">
                                <controls:Icon Width="15"
                                               Height="15"
                                               Data="{DynamicResource Icon.Monitor}"
                                               Foreground="{DynamicResource Brush.Text.Secondary}" />
                                <TextBlock Margin="7,0,0,0"
                                           Style="{DynamicResource Text.BodyStrong}"
                                           Text="{Binding SystemInfo.MachineName}" />
                                <Border Height="12"
                                        Margin="10,0"
                                        Style="{DynamicResource Divider.Vertical}" />
                                <TextBlock Style="{DynamicResource Text.Secondary}"
                                           Text="{Binding SystemInfo.Summary}" />
                            </StackPanel>
                        </Border>

                        <!-- Быстрое переключение темы -->
                        <Button Margin="8,0,0,0"
                                Command="{Binding ToggleThemeCommand}"
                                ToolTip="Переключить тему оформления">
                            <Button.Style>
                                <Style BasedOn="{StaticResource Button.Icon}" TargetType="{x:Type Button}">
                                    <Setter Property="controls:Assist.Icon" Value="{DynamicResource Icon.Moon}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                            <Setter Property="controls:Assist.Icon" Value="{DynamicResource Icon.Sun}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Кнопка перехода в настройки -->
                        <Button Margin="4,0,0,0"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="Settings"
                                Style="{DynamicResource Button.Icon}"
                                ToolTip="Настройки"
                                controls:Assist.Icon="{DynamicResource Icon.Settings}" />
                    </StackPanel>

                    <!-- Кнопки управления окном (Свернуть / Развернуть / Закрыть) -->
                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Top"
                                Orientation="Horizontal"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Click="OnMinimizeClick"
                                Style="{DynamicResource Button.WindowControl}"
                                ToolTip="Свернуть"
                                controls:Assist.Icon="{DynamicResource Icon.Window.Minimize}" />
                        <Button x:Name="MaxRestoreButton"
                                Click="OnMaximizeRestoreClick"
                                Style="{DynamicResource Button.WindowControl}"
                                ToolTip="Развернуть"
                                controls:Assist.Icon="{DynamicResource Icon.Window.Maximize}" />
                        <Button Click="OnCloseClick"
                                Style="{DynamicResource Button.WindowClose}"
                                ToolTip="Закрыть"
                                controls:Assist.Icon="{DynamicResource Icon.Window.Close}" />
                    </StackPanel>
                </Grid>

                <!-- =============== ЦЕНТРАЛЬНАЯ РАБОЧАЯ ОБЛАСТЬ =============== -->
                <controls:AnimatedContentControl Grid.Row="1"
                                                 Content="{Binding CurrentPage}" />
            </Grid>
        </Grid>
    </Border>
</Window>

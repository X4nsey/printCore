<UserControl x:Class="PrintCore.Views.DriverLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PrintCore.Controls"
             xmlns:converters="clr-namespace:PrintCore.Converters">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:StringToVisibilityConverter x:Key="StrToVis" />
    </UserControl.Resources>

    <ScrollViewer Style="{DynamicResource PageScrollViewer}">
        <StackPanel MaxWidth="1360">

            <!-- 1. Панель управления локальной библиотекой -->
            <Border Margin="{DynamicResource Margin.SectionGap}"
                    Padding="20,16"
                    Style="{DynamicResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{DynamicResource Text.CardTitle}"
                                   Text="Локальная библиотека драйверов" />
                        <TextBlock Margin="0,3,0,0"
                                   Style="{DynamicResource Text.Caption}"
                                   Text="{Binding StatusMessage}" />
                    </StackPanel>

                    <TextBox Grid.Column="1"
                             Margin="12,0"
                             VerticalAlignment="Center"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Фильтр по производителю, модели или версии" />

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                        <Button Command="{Binding RescanLibraryCommand}"
                                Content="Сканировать"
                                ToolTip="Просканировать папку библиотеки на наличие новых пакетов"
                                controls:Assist.Icon="{DynamicResource Icon.Refresh}" />
                        <Button Margin="8,0,0,0"
                                Command="{Binding ImportFolderCommand}"
                                Content="Импорт папки"
                                controls:Assist.Icon="{DynamicResource Icon.Folder}" />
                        <Button Margin="8,0,0,0"
                                Command="{Binding ImportFileCommand}"
                                Content="Добавить пакет"
                                Style="{DynamicResource Button.Primary}"
                                controls:Assist.Icon="{DynamicResource Icon.Package}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Основная сетка: таблица пакетов + карточка подробной информации о пакете -->
            <Grid Margin="{DynamicResource Margin.SectionGap}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.45*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <!-- Таблица пакетов в библиотеке -->
                <Border Grid.Column="0" Style="{DynamicResource Card.Flush}">
                    <Grid MinHeight="380">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DataGrid Grid.Row="0"
                                  ItemsSource="{Binding FilteredDrivers}"
                                  SelectedItem="{Binding SelectedDriver, Mode=TwoWay}"
                                  Style="{DynamicResource DataTable}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="0.95*"
                                                    Binding="{Binding Manufacturer}"
                                                    ElementStyle="{DynamicResource DataTable.CellText}"
                                                    Header="Производитель" />
                                <DataGridTextColumn Width="1.45*"
                                                    Binding="{Binding Model}"
                                                    ElementStyle="{DynamicResource DataTable.CellText}"
                                                    Header="Модель" />
                                <DataGridTextColumn Width="0.9*"
                                                    Binding="{Binding DriverVersion, TargetNullValue='—'}"
                                                    ElementStyle="{DynamicResource DataTable.CellTextSecondary}"
                                                    Header="Версия" />
                                <DataGridTextColumn Width="0.8*"
                                                    Binding="{Binding ArchitectureText}"
                                                    ElementStyle="{DynamicResource DataTable.CellTextSecondary}"
                                                    Header="Архитектура" />
                                <DataGridTextColumn Width="0.75*"
                                                    Binding="{Binding SizeText}"
                                                    ElementStyle="{DynamicResource DataTable.CellTextSecondary}"
                                                    Header="Размер" />
                                <DataGridTemplateColumn Width="1.15*" Header="Подпись">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <controls:StatusBadge Text="{Binding PackageTypeText}"
                                                                  Tone="{Binding SignatureTone}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <controls:EmptyState Grid.Row="1"
                                             Description="Импортируйте папку с INF-драйвером, добавьте архив/установщик вручную или загрузите пакет по официальной ссылке ниже."
                                             Icon="{DynamicResource Icon.Package}"
                                             Title="Локальная библиотека пока пуста"
                                             Visibility="{Binding HasDrivers, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                            <StackPanel Orientation="Horizontal">
                                <Button Command="{Binding ImportFolderCommand}"
                                        Content="Импорт папки"
                                        controls:Assist.Icon="{DynamicResource Icon.Folder}" />
                                <Button Margin="8,0,0,0"
                                        Command="{Binding ImportFileCommand}"
                                        Content="Добавить файл"
                                        Style="{DynamicResource Button.Primary}"
                                        controls:Assist.Icon="{DynamicResource Icon.Package}" />
                            </StackPanel>
                        </controls:EmptyState>
                    </Grid>
                </Border>

                <!-- Панель сведений о выбранном драйвере -->
                <Border Grid.Column="2" Style="{DynamicResource Card}">
                    <Grid>
                        <controls:EmptyState Description="Выберите пакет драйвера в таблице слева, чтобы просмотреть поддерживаемые версии Windows, контрольную сумму SHA-256, цифровую подпись и выполнить установку."
                                             Icon="{DynamicResource Icon.Info}"
                                             Title="Пакет не выбран"
                                             Visibility="{Binding HasSelectedDriver, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />

                        <StackPanel Visibility="{Binding HasSelectedDriver, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{DynamicResource Text.CardTitle}"
                                       Text="{Binding SelectedDriver.DisplayTitle}" />
                            <TextBlock Margin="0,3,0,12"
                                       Style="{DynamicResource Text.Caption}"
                                       Text="{Binding SelectedDriver.SignatureText}" />

                            <Border Style="{DynamicResource Divider}" />

                            <Grid Margin="0,12,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="135" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="26" />
                                    <RowDefinition Height="26" />
                                    <RowDefinition Height="26" />
                                    <RowDefinition Height="26" />
                                    <RowDefinition Height="26" />
                                    <RowDefinition Height="26" />
                                    <RowDefinition Height="26" />
                                    <RowDefinition Height="26" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{DynamicResource Text.Secondary}" Text="Производитель" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Style="{DynamicResource Text.BodyStrong}" Text="{Binding SelectedDriver.Manufacturer}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Style="{DynamicResource Text.Secondary}" Text="Модель" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{DynamicResource Text.Body}" Text="{Binding SelectedDriver.Model}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Style="{DynamicResource Text.Secondary}" Text="Версия пакета" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Style="{DynamicResource Text.Body}" Text="{Binding SelectedDriver.DriverVersion, TargetNullValue='Не указана'}" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Style="{DynamicResource Text.Secondary}" Text="Архитектура" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Style="{DynamicResource Text.Body}" Text="{Binding SelectedDriver.ArchitectureText}" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Style="{DynamicResource Text.Secondary}" Text="Поддержка ОС" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Style="{DynamicResource Text.Body}" Text="{Binding SelectedDriver.SupportedOsText}" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Style="{DynamicResource Text.Secondary}" Text="Источник" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Style="{DynamicResource Text.Body}" Text="{Binding SelectedDriver.SourceName}" />

                                <TextBlock Grid.Row="6" Grid.Column="0" Style="{DynamicResource Text.Secondary}" Text="SHA-256" />
                                <TextBlock Grid.Row="6" Grid.Column="1"
                                           Style="{DynamicResource Text.Body}"
                                           Text="{Binding SelectedDriver.Sha256}"
                                           ToolTip="{Binding SelectedDriver.Sha256}" />

                                <TextBlock Grid.Row="7" Grid.Column="0" Style="{DynamicResource Text.Secondary}" Text="Дата добавления" />
                                <TextBlock Grid.Row="7" Grid.Column="1" Style="{DynamicResource Text.Body}" Text="{Binding SelectedDriver.AddedAtText}" />
                            </Grid>

                            <Button HorizontalAlignment="Stretch"
                                    Command="{Binding InstallSelectedCommand}"
                                    Content="Установить драйвер в систему"
                                    Style="{DynamicResource Button.Primary}"
                                    controls:Assist.Icon="{DynamicResource Icon.Shield}" />

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Command="{Binding OpenPackageFolderCommand}"
                                        Content="Открыть папку"
                                        controls:Assist.Icon="{DynamicResource Icon.Folder}" />
                                <Button Grid.Column="2"
                                        Command="{Binding DeleteRecordOnlyCommand}"
                                        Content="Убрать из списка"
                                        controls:Assist.Icon="{DynamicResource Icon.Trash}" />
                            </Grid>

                            <Button Margin="0,8,0,0"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding DeleteWithFilesCommand}"
                                    Content="Удалить запись и файлы с диска…"
                                    Style="{DynamicResource Button.Ghost}"
                                    controls:Assist.Icon="{DynamicResource Icon.Trash}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- 3. Загрузка пакета по прямой официальной ссылке + каталоги производителей -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <!-- Модуль загрузки драйвера -->
                <Border Grid.Column="0" Style="{DynamicResource Card}">
                    <StackPanel>
                        <TextBlock Style="{DynamicResource Text.CardTitle}"
                                   Text="Загрузка пакета из официального источника" />
                        <TextBlock Margin="0,3,0,14"
                                   Style="{DynamicResource Text.Caption}"
                                   Text="Скачивание по прямой HTTPS-ссылке с проверкой целостности SHA-256 и цифровой подписи" />

                        <TextBlock Margin="0,0,0,4" Style="{DynamicResource Text.Label}" Text="Прямой URL файла пакета (.zip, .exe, .msi, .cab)" />
                        <TextBox Text="{Binding DownloadUrl, UpdateSourceTrigger=PropertyChanged}" />

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Margin="0,0,0,4" Style="{DynamicResource Text.Label}" Text="Производитель (необязательно)" />
                                <TextBox Text="{Binding DownloadManufacturer, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Margin="0,0,0,4" Style="{DynamicResource Text.Label}" Text="Модель (необязательно)" />
                                <TextBox Text="{Binding DownloadModel, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Margin="0,10,0,4" Style="{DynamicResource Text.Label}" Text="Ожидаемый SHA-256 (необязательно, для сверки)" />
                        <TextBox Text="{Binding DownloadExpectedSha256, UpdateSourceTrigger=PropertyChanged}" />

                        <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                            <Button Command="{Binding StartDownloadCommand}"
                                    Content="Загрузить в библиотеку"
                                    Style="{DynamicResource Button.Primary}"
                                    controls:Assist.Icon="{DynamicResource Icon.Download}" />
                            <Button Margin="8,0,0,0"
                                    Command="{Binding CancelDownloadCommand}"
                                    Content="Отменить"
                                    Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>

                        <ProgressBar Height="6"
                                     Margin="0,12,0,0"
                                     Background="{DynamicResource Brush.Neutral.Subtle}"
                                     BorderThickness="0"
                                     Foreground="{DynamicResource Brush.Accent}"
                                     Maximum="100"
                                     Value="{Binding DownloadProgressPercent, Mode=OneWay}"
                                     Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}" />

                        <TextBlock Margin="0,8,0,0"
                                   Style="{DynamicResource Text.Caption}"
                                   Text="{Binding DownloadProgressText}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding DownloadProgressText, Converter={StaticResource StrToVis}}" />
                    </StackPanel>
                </Border>

                <!-- Официальные порталы производителей -->
                <Border Grid.Column="2" Style="{DynamicResource Card}">
                    <StackPanel>
                        <TextBlock Style="{DynamicResource Text.CardTitle}"
                                   Text="Официальные порталы производителей" />
                        <TextBlock Margin="0,3,0,14"
                                   Style="{DynamicResource Text.Caption}"
                                   Text="Проверенные центры загрузки драйверов без сторонних сайтов" />

                        <ItemsControl ItemsSource="{Binding OfficialManufacturers}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,0,8,8"
                                            HorizontalContentAlignment="Left"
                                            Command="{Binding DataContext.OpenManufacturerPortalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Content="{Binding Name}"
                                            ToolTip="{Binding OfficialSiteUrl}"
                                            controls:Assist.Icon="{DynamicResource Icon.ArrowRight}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>

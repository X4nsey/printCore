<UserControl x:Class="PrintCore.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PrintCore.Controls"
             xmlns:converters="clr-namespace:PrintCore.Converters">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:DriverStatusToTextConverter x:Key="StatusText" />
        <converters:DriverStatusToToneConverter x:Key="StatusTone" />
    </UserControl.Resources>

    <ScrollViewer Style="{DynamicResource PageScrollViewer}">
        <StackPanel MaxWidth="1360">

            <!-- 1. Приветственный блок -->
            <Border Margin="{DynamicResource Margin.SectionGap}"
                    Padding="24,22"
                    Style="{DynamicResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{DynamicResource Text.Hero}"
                                   Text="{Binding WelcomeTitle}" />
                        <TextBlock Margin="0,6,0,0"
                                   Style="{DynamicResource Text.Subtitle}"
                                   Text="{Binding WelcomeSubtitle}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Margin="20,0,0,0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <Button Command="{Binding OpenDriverLibraryCommand}"
                                Content="Библиотека драйверов"
                                controls:Assist.Icon="{DynamicResource Icon.Package}" />
                        <Button Margin="10,0,0,0"
                                Command="{Binding FindPrintersCommand}"
                                Content="Найти принтеры"
                                Style="{DynamicResource Button.Primary}"
                                controls:Assist.Icon="{DynamicResource Icon.Scan}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Карточки статистики -->
            <Grid Margin="{DynamicResource Margin.SectionGap}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ContentControl Grid.Column="0" Content="{Binding FoundPrintersCard}" Focusable="False" />
                <ContentControl Grid.Column="2" Content="{Binding InstalledPrintersCard}" Focusable="False" />
                <ContentControl Grid.Column="4" Content="{Binding DriversCard}" Focusable="False" />
            </Grid>

            <!-- 3. Основная сетка: обнаруженные принтеры + быстрые действия и последние операции -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.65*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <!-- Блок последних обнаруженных принтеров -->
                <Border Grid.Column="0" Style="{DynamicResource Card.Flush}">
                    <Grid MinHeight="380">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Заголовок карточки -->
                        <Grid Grid.Row="0" Margin="20,18,20,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Style="{DynamicResource Text.CardTitle}"
                                           Text="Последние обнаруженные принтеры" />
                                <TextBlock Margin="0,3,0,0"
                                           Style="{DynamicResource Text.Caption}"
                                           Text="Устройства, найденные в сети и по USB" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Command="{Binding FindPrintersCommand}"
                                    Content="Перейти к поиску"
                                    Style="{DynamicResource Button.Link}"
                                    controls:Assist.Icon="{DynamicResource Icon.ArrowRight}" />
                        </Grid>

                        <!-- Таблица с колонками (видна всегда, чтобы структура блока была понятна) -->
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <DataGrid Grid.Row="0"
                                      ItemsSource="{Binding RecentPrinters}"
                                      Style="{DynamicResource DataTable}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Width="1.4*"
                                                        Binding="{Binding Model}"
                                                        ElementStyle="{DynamicResource DataTable.CellText}"
                                                        Header="Модель принтера" />
                                    <DataGridTextColumn Width="1*"
                                                        Binding="{Binding Manufacturer}"
                                                        ElementStyle="{DynamicResource DataTable.CellTextSecondary}"
                                                        Header="Производитель" />
                                    <DataGridTextColumn Width="1.05*"
                                                        Binding="{Binding ConnectionText}"
                                                        ElementStyle="{DynamicResource DataTable.CellTextSecondary}"
                                                        Header="Тип подключения" />
                                    <DataGridTextColumn Width="0.95*"
                                                        Binding="{Binding IpAddressText}"
                                                        ElementStyle="{DynamicResource DataTable.CellTextSecondary}"
                                                        Header="IP-адрес" />
                                    <DataGridTemplateColumn Width="1.1*" Header="Статус драйвера">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <controls:StatusBadge
                                                    Text="{Binding DriverStatus, Converter={StaticResource StatusText}}"
                                                    Tone="{Binding DriverStatus, Converter={StaticResource StatusTone}}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Пустое состояние -->
                            <controls:EmptyState Grid.Row="1"
                                                 Description="{Binding RecentPrintersEmptyDescription}"
                                                 Icon="{DynamicResource Icon.Printer}"
                                                 Title="Принтеры ещё не обнаружены"
                                                 Visibility="{Binding HasRecentPrinters, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                                <Button Command="{Binding FindPrintersCommand}"
                                        Content="Найти принтеры"
                                        controls:Assist.Icon="{DynamicResource Icon.Search}" />
                            </controls:EmptyState>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Правая колонка: Быстрые действия + Последние операции -->
                <StackPanel Grid.Column="2">

                    <!-- Быстрые действия -->
                    <Border Margin="0,0,0,16" Style="{DynamicResource Card}">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource Text.CardTitle}"
                                       Text="Быстрые действия" />
                            <TextBlock Margin="0,3,0,14"
                                       Style="{DynamicResource Text.Caption}"
                                       Text="Основные операции с принтерами и драйверами" />

                            <Button Margin="0,0,0,8"
                                    Command="{Binding FindPrintersCommand}"
                                    Content="Найти принтеры"
                                    Style="{DynamicResource Button.ListAction}"
                                    controls:Assist.Description="Обнаружение USB- и сетевых устройств"
                                    controls:Assist.Icon="{DynamicResource Icon.Search}" />

                            <Button Margin="0,0,0,8"
                                    Command="{Binding OpenDriverLibraryCommand}"
                                    Content="Открыть библиотеку драйверов"
                                    Style="{DynamicResource Button.ListAction}"
                                    controls:Assist.Description="Локальное хранилище пакетов драйверов"
                                    controls:Assist.Icon="{DynamicResource Icon.Package}" />

                            <Button Command="{Binding OpenInstalledPrintersCommand}"
                                    Content="Посмотреть установленные принтеры"
                                    Style="{DynamicResource Button.ListAction}"
                                    controls:Assist.Description="Очереди печати, зарегистрированные в системе"
                                    controls:Assist.Icon="{DynamicResource Icon.Printer}" />
                        </StackPanel>
                    </Border>

                    <!-- Блок последних операций -->
                    <Border Style="{DynamicResource Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Style="{DynamicResource Text.CardTitle}"
                                               Text="Последние операции" />
                                    <TextBlock Margin="0,3,0,0"
                                               Style="{DynamicResource Text.Caption}"
                                               Text="Обнаружение, поиск, загрузка и установка" />
                                </StackPanel>

                                <Button Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Command="{Binding OpenHistoryCommand}"
                                        Content="Вся история"
                                        Style="{DynamicResource Button.Link}"
                                        controls:Assist.Icon="{DynamicResource Icon.ArrowRight}" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding RecentOperations}"
                                          Visibility="{Binding HasRecentOperations, Converter={StaticResource BoolToVis}}" />

                            <controls:EmptyState Padding="12,18,12,8"
                                                 Description="Здесь отображаются обнаружение принтеров, поиск, загрузка и установка драйверов, а также ошибки операций."
                                                 Icon="{DynamicResource Icon.Activity}"
                                                 Title="Операции ещё не выполнялись"
                                                 Visibility="{Binding HasRecentOperations, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>

<Application x:Class="PrintCore.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PrintCore.Views"
             xmlns:vm="clr-namespace:PrintCore.ViewModels">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 1. Палитра темы (по умолчанию светлая, заменяется при запуске из настроек) -->
                <ResourceDictionary Source="Themes/Light.xaml" />

                <!-- 2. Дизайн-токены и векторные иконки -->
                <ResourceDictionary Source="Styles/Tokens.xaml" />
                <ResourceDictionary Source="Styles/Icons.xaml" />

                <!-- 3. Переиспользуемые стили компонентов -->
                <ResourceDictionary Source="Styles/Text.xaml" />
                <ResourceDictionary Source="Styles/Buttons.xaml" />
                <ResourceDictionary Source="Styles/Cards.xaml" />
                <ResourceDictionary Source="Styles/Navigation.xaml" />
                <ResourceDictionary Source="Styles/DataDisplay.xaml" />
                <ResourceDictionary Source="Styles/ScrollBars.xaml" />
                <ResourceDictionary Source="Styles/Inputs.xaml" />
                <ResourceDictionary Source="Styles/Templates.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Соответствие моделей представления разделам интерфейса (MVVM) -->
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PrinterDiscoveryViewModel}">
                <views:PrinterDiscoveryView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:InstalledPrintersViewModel}">
                <views:InstalledPrintersView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DriverLibraryViewModel}">
                <views:DriverLibraryView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:OperationHistoryViewModel}">
                <views:OperationHistoryView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
